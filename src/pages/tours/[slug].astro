---
import type { GetStaticPaths } from 'astro'
import { getCollection, render } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { formatAltitude, formatDuration, formatPrice } from '@/lib/format'

export const getStaticPaths = (async () => {
  const tours = await getCollection('tours')
  return tours.map((tour) => ({ params: { slug: tour.id }, props: { tour } }))
}) satisfies GetStaticPaths

const { tour } = Astro.props
const { Content } = await render(tour)
const { data } = tour
---

<!-- Página provisional: el diseño se hará en su propia etapa -->
<BaseLayout title={data.title} description={data.summary}>
  <article class="container-page max-w-3xl py-24">
    <a href="/" class="text-sm text-bali-hai hover:underline">
      ← Volver al inicio
    </a>
    <h1 class="mt-6 text-4xl sm:text-5xl">{data.title}</h1>
    <p class="mt-4 text-lg text-bali-hai">{data.summary}</p>

    <dl class="mt-8 grid grid-cols-2 gap-4 text-sm sm:grid-cols-4">
      <div>
        <dt class="text-bali-hai">Precio</dt>
        <dd class="text-tide">{formatPrice(data.priceCLP)}</dd>
      </div>
      <div>
        <dt class="text-bali-hai">Duración</dt>
        <dd>{formatDuration(data.durationHours)}</dd>
      </div>
      <div>
        <dt class="text-bali-hai">Salida</dt>
        <dd>{data.startTime}</dd>
      </div>
      <div>
        <dt class="text-bali-hai">Altura</dt>
        <dd>{formatAltitude(data.altitudeMeters)}</dd>
      </div>
    </dl>

    <div class="mt-10 space-y-4">
      <Content />
    </div>
  </article>
</BaseLayout>
