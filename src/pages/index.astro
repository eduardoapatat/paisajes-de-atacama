---
import BaseLayout from '../layouts/BaseLayout.astro'
import { site } from '../config/site'
---

<BaseLayout>
  <!-- Las secciones se agregan una a una desde src/components/sections/ -->
  <section class="container-page grid min-h-dvh place-content-center gap-4 text-center">
    <h1 class="text-5xl sm:text-7xl">{site.name}</h1>
    <p class="text-lg text-star-400">{site.tagline}</p>
  </section>
</BaseLayout>
