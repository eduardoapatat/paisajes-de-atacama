---
import { Picture } from 'astro:assets'
import nightImage from '@/assets/images/valle-de-la-luna-noche.jpg'

// Foto con licencia CC BY 4.0: el crédito debe quedar visible y enlazado
const credit = {
  author: 'P. Horálek/ESO',
  href: 'https://www.eso.org/public/images/potw2348a/',
  license: 'CC BY 4.0',
  licenseHref: 'https://creativecommons.org/licenses/by/4.0/deed.es',
}
---

<section id="noche" data-noche class="relative h-svh overflow-hidden bg-desert-night">
  <!--
    Resplandor del atardecer en el horizonte: la capa externa aparece al entrar
    y la interna se apaga mientras salen las estrellas (cada una con su trigger)
  -->
  <div aria-hidden="true" data-noche-dusk class="absolute inset-0 opacity-0">
    <div
      data-noche-dusk-glow
      class="absolute inset-0 bg-linear-to-t from-dusk/30 via-dusk/5 to-transparent"
    ></div>
  </div>

  <!-- Estrellas dibujadas en canvas: la foto las tapa al abrirse -->
  <canvas aria-hidden="true" data-noche-stars class="absolute inset-0 h-full w-full"></canvas>

  <!-- La foto se abre en un círculo centrado en el cielo -->
  <div data-noche-media data-reveal class="absolute inset-0">
    <Picture
      src={nightImage}
      alt="La Vía Láctea sobre las formaciones de sal del Valle de la Luna, de noche"
      widths={[640, 1024, 1600, 2400, 3200]}
      sizes="100vw"
      formats={['avif', 'webp']}
      data-noche-image
      class="h-full w-full object-cover object-[50%_40%]"
    />
    <div
      aria-hidden="true"
      class="absolute inset-0 bg-linear-to-b from-desert-night/40 via-transparent to-desert-night/70"
    ></div>
  </div>

  <div class="container-page relative flex h-full items-center justify-center">
    <h2 data-noche-title data-reveal class="text-center text-5xl text-sand sm:text-7xl lg:text-8xl">
      En la noche...
    </h2>
  </div>

  <p
    data-noche-credit
    data-reveal
    class="absolute right-5 bottom-4 text-xs text-sand/70 sm:right-8"
  >
    Foto:{' '}
    <a href={credit.href} class="underline-offset-2 hover:text-sand hover:underline">
      {credit.author}
    </a>
    {' · '}
    <a href={credit.licenseHref} class="underline-offset-2 hover:text-sand hover:underline">
      {credit.license}
    </a>
  </p>
</section>

<script>
  import { animate, gsap, ScrollTrigger, SplitText } from '@/lib/gsap'
  import { createStarfield } from '@/lib/starfield'

  const section = document.querySelector<HTMLElement>('[data-noche]')
  const title = section?.querySelector<HTMLElement>('[data-noche-title]')
  const canvas = section?.querySelector<HTMLCanvasElement>('[data-noche-stars]')

  if (section && title && canvas) {
    animate(section, ({ reduceMotion, afterFonts }) => {
      // Con movimiento reducido la foto ya está abierta y sus estrellas bastan
      if (reduceMotion) return

      const stars = createStarfield(canvas)

      // La foto carga en diferido, pero si el scroll salta directo a la sección
      // fija el navegador no la pide: se fuerza la carga unas pantallas antes
      const image = section.querySelector<HTMLImageElement>('[data-noche-image]')
      ScrollTrigger.create({
        trigger: section,
        start: 'top 300%',
        once: true,
        onEnter: () => image && (image.loading = 'eager'),
      })

      // Mientras la sección sube, oscurece y salen las estrellas más brillantes
      gsap
        .timeline({
          scrollTrigger: { trigger: section, start: 'top bottom', end: 'top top', scrub: true },
        })
        .fromTo(stars.state, { revealEnter: 0 }, { revealEnter: 0.5, ease: 'none' }, 0)
        .fromTo('[data-noche-dusk]', { autoAlpha: 0 }, { autoAlpha: 1, ease: 'none' }, 0)

      afterFonts(() => {
        const split = SplitText.create(title, { type: 'chars' })

        // La sección queda fija y todo avanza con el scroll: terminan de salir las
        // estrellas y el título letra por letra, después la foto se abre desde el
        // centro del cielo y tapa el canvas. El cielo gira apenas todo el tramo.
        gsap
          .timeline({
            scrollTrigger: {
              trigger: section,
              start: 'top top',
              end: '+=100%',
              pin: true,
              scrub: true,
            },
          })
          .set(title, { autoAlpha: 1 }, 0)
          .fromTo(
            stars.state,
            { revealPin: 0 },
            { revealPin: 0.5, duration: 0.45, ease: 'none' },
            0,
          )
          .fromTo(stars.state, { spin: 0 }, { spin: 0.04, duration: 1.55, ease: 'none' }, 0)
          .fromTo(
            '[data-noche-dusk-glow]',
            { autoAlpha: 1 },
            { autoAlpha: 0, duration: 0.4, ease: 'none' },
            0,
          )
          .fromTo(
            split.chars,
            { autoAlpha: 0, y: 40, filter: 'blur(10px)' },
            { autoAlpha: 1, y: 0, filter: 'blur(0px)', stagger: 0.04, duration: 0.3 },
            0,
          )
          .fromTo(
            '[data-noche-media]',
            { autoAlpha: 1, clipPath: 'circle(0% at 50% 40%)' },
            { clipPath: 'circle(75% at 50% 40%)', duration: 1, ease: 'power2.inOut' },
            0.35,
          )
          .fromTo(
            '[data-noche-image]',
            { scale: 1.4 },
            { scale: 1, duration: 1.2, ease: 'none' },
            0.35,
          )
          // El crédito aparece cuando la foto ya está abierta
          .fromTo('[data-noche-credit]', { autoAlpha: 0 }, { autoAlpha: 1, duration: 0.2 }, 1.2)
          // Con la foto completa el canvas ya no se ve: deja de dibujar
          .to(stars.state, { opacity: 0, duration: 0.15, ease: 'none' }, 1.35)
      })

      return () => stars.destroy()
    })
  }
</script>
