---
import { getCollection } from 'astro:content'
import { site } from '@/config/site'

const paisajes = (await getCollection('paisajes')).sort((a, b) => a.data.order - b.data.order)

const columns = [
  {
    title: 'Explorar',
    links: [
      // Mismo orden que las secciones en la página. Sin `href`, se muestra como texto
      { href: '/#paisajes', label: 'Paisajes' },
      { href: '/#atractivos', label: 'Otros lugares' },
      { href: '/#antes-de-viajar', label: 'Antes de viajar' },
      { href: '/#noche', label: 'En la noche' },
    ],
  },
  {
    title: 'Paisajes',
    links: paisajes.map((paisaje) => ({
      href: `/paisajes/${paisaje.id}`,
      label: paisaje.data.title,
    })),
  },
]

const year = new Date().getFullYear()
---

<footer class="border-t border-dusk/20 bg-desert-night text-dusk">
  <div class="mx-auto max-w-6xl px-6 py-12">
    <div class="grid gap-10 sm:grid-cols-3">
      <div>
        <p class="text-lg font-medium text-sand">{site.name}</p>
        <p class="mt-2 text-sm">
          {site.location.name}, {site.location.country}
        </p>
      </div>

      {columns.map((column) => (
        <nav aria-label={column.title}>
          <p class="text-sm font-medium text-sand">{column.title}</p>
          <ul class="mt-2 text-sm">
            {column.links.map((link) => (
              <li>
                {link.href ? (
                  <a href={link.href} class="inline-block py-1 transition-colors hover:text-gold">
                    {link.label}
                  </a>
                ) : (
                  <span class="inline-block py-1 text-dusk/70">{link.label}</span>
                )}
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>

    <p class="mt-12 border-t border-dusk/20 pt-6 text-sm">
      © {year} · Creado por {site.author}
    </p>
  </div>
</footer>
