---
import { Picture } from 'astro:assets'
import { getCollection } from 'astro:content'
import { formatAltitude, formatChapter } from '@/lib/format'

const paisajes = (await getCollection('paisajes')).sort((a, b) => a.data.order - b.data.order)
---

<!-- Cortina: sube por encima del hero fijo, con esquinas redondeadas y sombra -->
<section
  id="paisajes"
  data-paisajes
  class="relative z-10 rounded-t-[2rem] bg-sand py-24 text-desert-night shadow-[0_-24px_60px_rgb(0_0_0/0.35)] sm:rounded-t-[3rem] sm:py-32"
>
  <header data-paisajes-heading class="container-page max-w-3xl text-center">
    <h2 data-reveal class="text-4xl text-desert-night sm:text-5xl">
      {paisajes.length} lugares del Desierto de Atacama
    </h2>
  </header>

  <div class="mt-20 space-y-28 sm:mt-28 sm:space-y-40">
    {paisajes.map((paisaje, index) => {
      const { data } = paisaje
      const reversed = index % 2 === 1
      return (
        <article
          data-chapter
          class="container-page grid items-center gap-10 lg:grid-cols-12 lg:gap-16"
        >
          {/* Foto: la máscara la revela y el contenedor interno hace el parallax */}
          <div
            data-chapter-media
            data-reveal
            class:list={[
              'relative aspect-4/3 overflow-hidden rounded-2xl lg:col-span-7 lg:aspect-5/4',
              reversed && 'lg:order-last',
            ]}
          >
            <div data-chapter-parallax class="absolute inset-x-0 -top-[10%] h-[120%]">
              <Picture
                src={data.cover}
                alt={data.coverAlt}
                widths={[640, 1024, 1600, 2400]}
                sizes="(min-width: 1024px) 58vw, 100vw"
                formats={['avif', 'webp']}
                class="h-full w-full object-cover"
              />
            </div>
          </div>

          <div class="lg:col-span-5">
            <p
              data-chapter-number
              data-reveal
              aria-hidden="true"
              class="text-7xl font-light text-gold sm:text-8xl"
            >
              {formatChapter(index)}
            </p>
            <h3
              data-chapter-title
              data-split-mask
              data-reveal
              class="mt-4 text-3xl text-desert-night sm:text-4xl"
            >
              {data.title}
            </h3>
            <p data-chapter-meta data-reveal class="mt-4 text-sm text-desert-night/70">
              {data.location} · {formatAltitude(data.altitudeMeters)}
            </p>
            <p
              data-chapter-intro
              data-reveal
              class="mt-6 text-lg leading-relaxed text-desert-night/80"
            >
              {data.intro}
            </p>
            <a
              href={`/paisajes/${paisaje.id}`}
              data-chapter-link
              data-reveal
              class="group mt-8 inline-flex items-center gap-2 border-b border-gold pb-1 text-sm font-medium text-desert-night"
            >
              Leer su historia
              <span
                aria-hidden="true"
                class="transition-transform motion-safe:group-hover:translate-x-1"
              >
                →
              </span>
            </a>
          </div>
        </article>
      )
    })}
  </div>
</section>

<script>
  import { animate, fadeIn, gsap, MOTION, SplitText } from '@/lib/gsap'

  const section = document.querySelector<HTMLElement>('[data-paisajes]')

  if (section) {
    animate(section, ({ reduceMotion, afterFonts }) => {
      // Sin desplazamientos ni máscaras: cada bloque aparece con un fundido corto
      if (reduceMotion) {
        fadeIn(section.querySelectorAll('[data-paisajes-heading], [data-chapter]'))
        return
      }

      const chapters = section.querySelectorAll<HTMLElement>('[data-chapter]')

      // Parallax de cada foto: no depende de la fuente, se crea de inmediato
      chapters.forEach((chapter) => {
        gsap.fromTo(
          chapter.querySelector('[data-chapter-parallax]'),
          { yPercent: -8 },
          {
            yPercent: 8,
            ease: 'none',
            scrollTrigger: {
              trigger: chapter,
              start: 'top bottom',
              end: 'bottom top',
              scrub: true,
            },
          },
        )
      })

      // Textos divididos en líneas: esperan a que cargue la fuente
      afterFonts(() => {
        const heading = section.querySelector<HTMLElement>('[data-paisajes-heading]')!
        gsap.fromTo(
          heading.children,
          { autoAlpha: 0, y: MOTION.rise },
          {
            autoAlpha: 1,
            y: 0,
            stagger: MOTION.staggerBlock,
            duration: MOTION.text,
            ease: MOTION.ease,
            scrollTrigger: { trigger: heading, start: MOTION.start, once: true },
          },
        )

        // Dirección desde la que se descubre cada foto, en ciclo: abajo, izquierda,
        // derecha. Nunca desde arriba.
        const reveals = [
          'inset(100% 0% 0% 0%)', // desde abajo
          'inset(0% 100% 0% 0%)', // desde la izquierda
          'inset(0% 0% 0% 100%)', // desde la derecha
        ]

        chapters.forEach((chapter, index) => {
          const media = chapter.querySelector('[data-chapter-media]')
          const title = chapter.querySelector<HTMLElement>('[data-chapter-title]')!
          const intro = chapter.querySelector<HTMLElement>('[data-chapter-intro]')!

          const titleSplit = SplitText.create(title, { type: 'lines', mask: 'lines' })
          const introSplit = SplitText.create(intro, { type: 'lines', mask: 'lines' })

          // La máscara es el protagonista; el texto arranca casi a la vez y queda
          // legible en ~1 s (regla de DESIGN.md), sin esperar a que termine la foto
          gsap
            .timeline({
              defaults: { ease: MOTION.ease, duration: MOTION.text },
              scrollTrigger: { trigger: chapter, start: MOTION.start, once: true },
            })
            .fromTo(
              media,
              { autoAlpha: 1, clipPath: reveals[index % reveals.length] },
              { clipPath: 'inset(0% 0% 0% 0%)', duration: MOTION.mask, ease: MOTION.easeMask },
            )
            .fromTo(
              chapter.querySelector('[data-chapter-number]'),
              { autoAlpha: 0, y: MOTION.rise },
              { autoAlpha: 1, y: 0 },
              0.1,
            )
            .set([title, intro], { autoAlpha: 1 }, 0.15)
            .fromTo(
              titleSplit.lines,
              { yPercent: MOTION.maskFrom },
              { yPercent: 0, stagger: MOTION.stagger },
              0.15,
            )
            .fromTo(
              chapter.querySelector('[data-chapter-meta]'),
              { autoAlpha: 0 },
              { autoAlpha: 1 },
              0.3,
            )
            .fromTo(
              introSplit.lines,
              { yPercent: 105 },
              { yPercent: 0, stagger: MOTION.stagger },
              0.3,
            )
            .fromTo(
              chapter.querySelector('[data-chapter-link]'),
              { autoAlpha: 0, x: -MOTION.rise },
              { autoAlpha: 1, x: 0 },
              0.45,
            )
        })
      })
    })
  }
</script>
