---
// Sin `href`: la sección aún no existe y se muestra como texto, no como enlace
const links: { href?: string; label: string }[] = [
  { href: '/#paisajes', label: 'Paisajes' },
  { label: 'Antes de viajar' },
]
---

<header data-nav class="pointer-events-none fixed inset-x-0 top-4 z-40 px-4">
  <nav
    aria-label="Principal"
    data-nav-inner
    data-reveal
    class="pointer-events-auto mx-auto w-fit rounded-full border border-dusk/30 bg-desert-night/60 p-1.5 shadow-lg shadow-desert-night/40 backdrop-blur-md"
  >
    <ul class="flex items-center">
      {links.map((link) => (
        <li>
          {link.href ? (
            <a
              href={link.href}
              class="block rounded-full px-4 py-2 whitespace-nowrap text-sand transition-colors hover:bg-dusk/15 hover:text-gold"
            >
              {link.label}
            </a>
          ) : (
            <span class="block px-4 py-2 whitespace-nowrap text-sand/60">{link.label}</span>
          )}
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  import { animate, gsap, ScrollTrigger } from '@/lib/gsap'

  const header = document.querySelector<HTMLElement>('[data-nav]')
  const inner = header?.querySelector<HTMLElement>('[data-nav-inner]')

  if (header && inner) {
    animate(header, ({ reduceMotion }) => {
      if (reduceMotion) return

      // Entrada: el título del hero empieza primero, el navbar baja poco después.
      // Es navegación: entra rápido para no hacer esperar a quien quiere usarla.
      gsap.fromTo(
        inner,
        { y: -16, autoAlpha: 0 },
        { y: 0, autoAlpha: 1, duration: 0.3, ease: 'expo.out', delay: 0.6 },
      )

      // Se oculta al bajar y reaparece al subir. Solo anima cuando cambia de
      // estado, no en cada evento de scroll.
      let hidden = false
      const setHidden = (value: boolean) => {
        if (value === hidden) return
        hidden = value
        gsap.to(header, {
          yPercent: value ? -200 : 0,
          duration: 0.25,
          ease: 'expo.out',
          overwrite: 'auto',
        })
      }

      ScrollTrigger.create({
        start: 0,
        end: 'max',
        onUpdate: (self) => {
          // Con el foco dentro (teclado) se mantiene visible
          if (header.contains(document.activeElement)) return setHidden(false)
          setHidden(self.direction === 1 && self.scroll() > 200)
        },
      })

      // Si el foco entra con teclado mientras está oculto, se muestra
      const onFocusIn = () => setHidden(false)
      header.addEventListener('focusin', onFocusIn)
      return () => header.removeEventListener('focusin', onFocusIn)
    })
  }
</script>
