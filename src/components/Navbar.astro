---
const links = [
  { href: '/#paisajes', label: 'Paisajes' },
  { href: '/#antes-de-viajar', label: 'Antes de viajar' },
]
---

<header data-nav class="pointer-events-none fixed inset-x-0 top-4 z-40 px-4">
  <nav
    aria-label="Principal"
    data-nav-inner
    data-reveal
    class="pointer-events-auto mx-auto w-fit rounded-full border border-dusk/30 bg-desert-night/60 p-1.5 shadow-lg shadow-desert-night/40 backdrop-blur-md"
  >
    <ul class="flex items-center">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class="block rounded-full px-4 py-2 whitespace-nowrap text-sand transition-colors hover:bg-dusk/15 hover:text-gold"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  import { animate, gsap, ScrollTrigger } from '@/lib/gsap'

  const header = document.querySelector<HTMLElement>('[data-nav]')
  const inner = header?.querySelector<HTMLElement>('[data-nav-inner]')

  if (header && inner) {
    animate(header, ({ reduceMotion }) => {
      if (reduceMotion) return

      // Entrada: el hero anima primero, el navbar baja después
      gsap.fromTo(
        inner,
        { y: -32, autoAlpha: 0 },
        { y: 0, autoAlpha: 1, duration: 1.2, ease: 'expo.out', delay: 1.1 },
      )

      // Se oculta al bajar y reaparece al subir
      ScrollTrigger.create({
        start: 0,
        end: 'max',
        onUpdate: (self) => {
          const hide = self.direction === 1 && self.scroll() > 200
          gsap.to(header, {
            yPercent: hide ? -200 : 0,
            duration: 0.5,
            ease: 'power3.out',
            overwrite: 'auto',
          })
        },
      })
    })
  }
</script>
