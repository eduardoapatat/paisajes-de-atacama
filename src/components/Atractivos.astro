---
import { Picture } from 'astro:assets'
import { getCollection } from 'astro:content'
import PhotoCredit from '@/components/PhotoCredit.astro'
import { keepNumbersTogether } from '@/lib/format'

const atractivos = (await getCollection('atractivos'))
  .sort((a, b) => a.data.order - b.data.order)
  .map(({ data }) => data)

// Con un solo lugar, foto y texto van lado a lado en vez de una tarjeta suelta
// en una grilla de tres columnas con dos tercios vacíos
const single = atractivos.length === 1
---

<section
  id="atractivos"
  data-atractivos
  class="relative z-10 bg-sand pb-24 text-desert-night sm:pb-32"
>
  <div class="container-page">
    <header data-atractivos-heading class="max-w-2xl">
      <h2 data-reveal class="text-4xl text-desert-night sm:text-5xl">
        Otros lugares para conocer
      </h2>
    </header>

    <ul
      class:list={[
        'mt-14 grid',
        single ? 'max-w-5xl' : 'gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3',
      ]}
    >
      {atractivos.map((data) => {
        return (
          <li
            data-atractivo
            class:list={[single && 'grid items-center gap-8 sm:grid-cols-2 lg:gap-16']}
          >
            {/* Cuadrado que reserva el espacio de la foto */}
            <div
              data-atractivo-media
              data-reveal
              class="relative aspect-square overflow-hidden rounded-2xl bg-desert-night/5"
            >
              <Picture
                src={data.cover}
                alt={data.coverAlt}
                widths={[480, 800, 1200]}
                sizes={
                  single
                    ? '(min-width: 1024px) 480px, (min-width: 640px) 50vw, 100vw'
                    : '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw'
                }
                formats={['avif', 'webp']}
                data-atractivo-image
                class="h-full w-full object-cover"
              />
              <PhotoCredit {...data.coverCredit} />
            </div>

            <div class:list={[!single && 'mt-5']}>
              <p data-atractivo-text data-reveal class="text-sm text-desert-night/70">
                {keepNumbersTogether(data.location)}
              </p>
              <h3
                data-atractivo-text
                data-reveal
                class:list={[
                  'mt-2 text-desert-night',
                  single ? 'text-3xl sm:text-4xl' : 'text-2xl',
                ]}
              >
                {data.title}
              </h3>
              <p data-atractivo-text data-reveal class="mt-3 leading-relaxed text-desert-night/80">
                {data.summary}
              </p>

              {data.facts.length > 0 && (
                <dl
                  data-atractivo-text
                  data-reveal
                  class="mt-5 grid grid-cols-3 gap-4 border-t border-desert-night/10 pt-4"
                >
                  {data.facts.map((fact) => (
                    <div>
                      <dt class="text-sm text-desert-night/70">{fact.label}</dt>
                      <dd class="mt-1 text-sm font-medium tabular-nums">
                        {keepNumbersTogether(fact.value)}
                      </dd>
                    </div>
                  ))}
                </dl>
              )}
            </div>
          </li>
        )
      })}
    </ul>
  </div>
</section>

<script>
  import { animate, fadeIn, gsap, MOTION, ScrollTrigger } from '@/lib/gsap'

  const section = document.querySelector<HTMLElement>('[data-atractivos]')

  if (section) {
    animate(section, ({ reduceMotion }) => {
      // Sin desplazamientos ni máscaras: cada bloque aparece con un fundido corto
      if (reduceMotion) {
        fadeIn(section.querySelectorAll('[data-atractivos-heading], [data-atractivo]'))
        return
      }

      const heading = section.querySelectorAll('[data-atractivos-heading] > *')
      const cards = section.querySelectorAll<HTMLElement>('[data-atractivo]')

      // Estado inicial desde el principio (no recién al entrar), para que el
      // respaldo de `data-reveal` en global.css no las muestre antes de tiempo
      gsap.set(section.querySelectorAll('[data-atractivo-media]'), {
        autoAlpha: 1,
        clipPath: 'inset(100% 0% 0% 0% round 16px)',
      })
      gsap.set(section.querySelectorAll('[data-atractivo-text]'), { autoAlpha: 0 })
      gsap.fromTo(
        heading,
        { autoAlpha: 0, y: MOTION.rise },
        {
          autoAlpha: 1,
          y: 0,
          stagger: MOTION.staggerBlock,
          duration: MOTION.text,
          ease: MOTION.ease,
          scrollTrigger: { trigger: section, start: MOTION.start, once: true },
        },
      )

      // Cada tarjeta aparece sola cuando entra en pantalla; si entran varias a la
      // vez (una fila), se escalonan una tras otra
      const reveal = (card: HTMLElement, delay: number) => {
        const media = card.querySelector('[data-atractivo-media]')
        const image = card.querySelector('[data-atractivo-image]')
        const texts = card.querySelectorAll('[data-atractivo-text]')

        const tl = gsap.timeline({ delay, defaults: { ease: MOTION.ease } })
        // El cuadrado se abre de abajo hacia arriba
        tl.fromTo(
          media,
          { autoAlpha: 1, clipPath: 'inset(100% 0% 0% 0% round 16px)' },
          {
            clipPath: 'inset(0% 0% 0% 0% round 16px)',
            duration: MOTION.mask,
            ease: MOTION.easeMask,
          },
        )
        // La foto se asienta con un zoom suave mientras se abre
        tl.fromTo(image, { scale: MOTION.zoom }, { scale: 1, duration: MOTION.settle }, 0)
        // Los textos suben casi a la vez que la foto: legibles en ~1 s
        tl.fromTo(
          texts,
          { autoAlpha: 0, y: MOTION.rise },
          { autoAlpha: 1, y: 0, stagger: MOTION.stagger, duration: MOTION.text },
          0.25,
        )
      }

      ScrollTrigger.batch(cards, {
        start: MOTION.start,
        once: true,
        onEnter: (batch) =>
          batch.forEach((card, i) => reveal(card as HTMLElement, i * MOTION.staggerBlock)),
      })
    })
  }
</script>
