---
import { Picture } from 'astro:assets'
import { getCollection } from 'astro:content'

const atractivos = (await getCollection('atractivos'))
  .sort((a, b) => a.data.order - b.data.order)
  .map(({ data }) => data)
---

<section
  id="atractivos"
  data-atractivos
  class="relative z-10 bg-sand pb-24 text-desert-night sm:pb-32"
>
  <div class="container-page">
    <header data-atractivos-heading class="max-w-2xl">
      <p
        data-reveal
        class="text-xs font-medium tracking-[0.35em] text-desert-night/60 uppercase sm:text-sm"
      >
        Atractivos
      </p>
      <h2 data-reveal class="mt-4 text-4xl text-desert-night sm:text-5xl">
        Otros lugares para conocer
      </h2>
    </header>

    <ul class="mt-14 grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
      {atractivos.map((data) => {
        return (
          <li data-atractivo>
            {/* Cuadrado que reserva el espacio de la foto */}
            <div
              data-atractivo-media
              data-reveal
              class="relative aspect-square overflow-hidden rounded-2xl bg-desert-night/5"
            >
              <Picture
                src={data.cover}
                alt={data.coverAlt}
                widths={[480, 800, 1200]}
                sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                formats={['avif', 'webp']}
                data-atractivo-image
                class="h-full w-full object-cover"
              />
            </div>

            <div class="mt-5">
              <p data-atractivo-text data-reveal class="text-sm text-desert-night/60">
                {data.location}
              </p>
              <h3 data-atractivo-text data-reveal class="mt-2 text-2xl text-desert-night">
                {data.title}
              </h3>
              <p data-atractivo-text data-reveal class="mt-3 leading-relaxed text-desert-night/80">
                {data.summary}
              </p>

              {data.facts.length > 0 && (
                <dl
                  data-atractivo-text
                  data-reveal
                  class="mt-5 grid grid-cols-3 gap-4 border-t border-desert-night/10 pt-4"
                >
                  {data.facts.map((fact) => (
                    <div>
                      <dt class="text-xs text-desert-night/50">{fact.label}</dt>
                      <dd class="mt-1 text-sm font-medium">{fact.value}</dd>
                    </div>
                  ))}
                </dl>
              )}
            </div>
          </li>
        )
      })}
    </ul>
  </div>
</section>

<script>
  import { animate, gsap, ScrollTrigger } from '@/lib/gsap'

  const section = document.querySelector<HTMLElement>('[data-atractivos]')

  if (section) {
    animate(section, ({ reduceMotion }) => {
      if (reduceMotion) return

      const heading = section.querySelectorAll('[data-atractivos-heading] > *')
      const cards = section.querySelectorAll<HTMLElement>('[data-atractivo]')

      gsap.fromTo(
        heading,
        { autoAlpha: 0, y: 32 },
        {
          autoAlpha: 1,
          y: 0,
          stagger: 0.1,
          duration: 1.1,
          ease: 'expo.out',
          scrollTrigger: { trigger: section, start: 'top 75%', once: true },
        },
      )

      // Cada tarjeta aparece sola cuando entra en pantalla; si entran varias a la
      // vez (una fila), se escalonan una tras otra
      const reveal = (card: HTMLElement, delay: number) => {
        const media = card.querySelector('[data-atractivo-media]')
        const image = card.querySelector('[data-atractivo-image]')
        const texts = card.querySelectorAll('[data-atractivo-text]')

        const tl = gsap.timeline({ delay, defaults: { ease: 'expo.out' } })
        // El cuadrado se abre de abajo hacia arriba
        tl.fromTo(
          media,
          { autoAlpha: 1, clipPath: 'inset(100% 0% 0% 0% round 16px)' },
          { clipPath: 'inset(0% 0% 0% 0% round 16px)', duration: 1.3, ease: 'expo.inOut' },
        )
        // La foto se asienta con un zoom suave
        tl.fromTo(image, { scale: 1.25 }, { scale: 1, duration: 1.8 }, 0.2)
        // Los textos suben uno tras otro
        tl.fromTo(
          texts,
          { autoAlpha: 0, y: 24 },
          { autoAlpha: 1, y: 0, stagger: 0.08, duration: 1 },
          0.6,
        )
      }

      ScrollTrigger.batch(cards, {
        start: 'top 85%',
        once: true,
        onEnter: (batch) => batch.forEach((card, i) => reveal(card as HTMLElement, i * 0.18)),
      })
    })
  }
</script>
