---
import { Picture } from 'astro:assets'
import heroImage from '@/assets/images/desert-atacama-hero.jpg'
import { site } from '@/config/site'
---

<section id="inicio" data-hero class="relative h-svh overflow-hidden bg-desert-night">
  <!-- La foto ocupa toda la pantalla; este contenedor hace el parallax al bajar -->
  <div data-hero-media class="absolute inset-0">
    <Picture
      src={heroImage}
      alt="Altiplano de Atacama al atardecer, con pastizales dorados y volcanes bajo un cielo rosado"
      widths={[640, 1024, 1600, 2400, 3200]}
      sizes="100vw"
      formats={['avif', 'webp']}
      loading="eager"
      fetchpriority="high"
      data-hero-image
      data-reveal
      class="h-full w-full object-cover object-[50%_45%]"
    />
  </div>

  <!-- Oscurece la foto (que es clara) para que el texto se lea -->
  <div
    aria-hidden="true"
    class="absolute inset-0 bg-linear-to-b from-desert-night/50 via-desert-night/20 to-desert-night/90"
  ></div>

  <div
    data-hero-content
    class="container-page relative flex h-full flex-col items-center justify-center text-center"
  >
    <p
      data-hero-fade
      data-reveal
      class="text-xs font-medium tracking-[0.35em] text-gold uppercase sm:text-sm"
    >
      {site.location.name} · {site.location.country}
    </p>

    <h1
      data-hero-title
      data-reveal
      class="mt-5 text-5xl font-semibold tracking-tight drop-shadow-lg sm:text-7xl lg:text-8xl"
    >
      {site.name}
    </h1>

    <p data-hero-fade data-reveal class="mt-6 max-w-xl text-lg text-sand sm:text-xl">
      {site.tagline}
    </p>

    <div data-hero-fade data-reveal class="mt-10">
      <a
        href="#paisajes"
        class="rounded-full bg-gold px-6 py-3 font-medium text-desert-night transition-colors hover:bg-sand"
      >
        Explorar
      </a>
    </div>

    <p
      data-hero-fade
      data-reveal
      class="absolute bottom-8 text-xs tracking-[0.3em] text-sand/70 uppercase"
    >
      Desliza
    </p>
  </div>
</section>

<script>
  import { animate, gsap, SplitText } from '@/lib/gsap'

  const hero = document.querySelector<HTMLElement>('[data-hero]')
  const title = hero?.querySelector<HTMLElement>('[data-hero-title]')

  if (hero && title) {
    animate(hero, ({ reduceMotion, afterFonts }) => {
      if (reduceMotion) return

      // Cortina: el hero queda fijo sin agregar espacio de scroll (pinSpacing: false)
      // y la sección siguiente sube por encima hasta taparlo. Mientras tanto la foto
      // se acerca un poco y el texto se desvanece.
      gsap
        .timeline({
          scrollTrigger: {
            trigger: hero,
            start: 'top top',
            end: 'bottom top',
            pin: true,
            pinSpacing: false,
            scrub: true,
            refreshPriority: 1,
          },
        })
        .to('[data-hero-media]', { scale: 1.1, ease: 'none', duration: 1 }, 0)
        .to(
          '[data-hero-content]',
          { yPercent: -30, autoAlpha: 0, ease: 'power1.in', duration: 0.6 },
          0,
        )

      // Entrada al cargar: SplitText debe medir con la fuente final cargada
      afterFonts(() => {
        const split = SplitText.create(title, { type: 'words', mask: 'words' })
        gsap
          .timeline({ defaults: { ease: 'expo.out', duration: 1.4 } })
          .fromTo(
            hero.querySelector('[data-hero-image]'),
            { scale: 1.08, autoAlpha: 0 },
            { scale: 1, autoAlpha: 1, duration: 2.4 },
          )
          .set(title, { autoAlpha: 1 }, 0.3)
          .fromTo(split.words, { yPercent: 110 }, { yPercent: 0, stagger: 0.08 }, 0.3)
          .fromTo(
            hero.querySelectorAll('[data-hero-fade]'),
            { autoAlpha: 0, y: 24 },
            { autoAlpha: 1, y: 0, stagger: 0.12 },
            0.7,
          )
      })
    })
  }
</script>
