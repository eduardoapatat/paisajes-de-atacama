---
import { Picture } from 'astro:assets'
import heroImage from '@/assets/images/valle-de-la-muerte.jpg'
import PhotoCredit from '@/components/PhotoCredit.astro'
import { site } from '@/config/site'

// Foto con licencia CC BY-SA 3.0: el crédito debe quedar visible y enlazado
const credit = {
  author: 'Claire Provost',
  url: 'https://commons.wikimedia.org/wiki/File:Atardecer_en_Valle_de_la_Muerte,_Atacama,_Chile.JPG',
  license: 'CC BY-SA 3.0',
  licenseUrl: 'https://creativecommons.org/licenses/by-sa/3.0/deed.es',
}
---

<section id="inicio" data-hero class="relative h-svh overflow-hidden bg-desert-night">
  <!-- La foto ocupa toda la pantalla; este contenedor hace el parallax al bajar -->
  <div data-hero-media class="absolute inset-0">
    <Picture
      src={heroImage}
      alt="Valle de la Muerte al atardecer, con sus crestas de roca encendidas y los volcanes de la cordillera al fondo"
      widths={[640, 1024, 1600, 2400, 3200]}
      sizes="100vw"
      formats={['avif', 'webp']}
      loading="eager"
      fetchpriority="high"
      data-hero-image
      class="h-full w-full object-cover object-[50%_45%]"
    />
  </div>

  <!-- Oscurece la foto para que el texto se lea -->
  <div
    aria-hidden="true"
    class="absolute inset-0 bg-linear-to-b from-desert-night/50 via-desert-night/20 to-desert-night/90"
  ></div>

  <div
    data-hero-content
    class="container-page relative flex h-full flex-col items-center justify-center text-center"
  >
    <h1
      data-hero-title
      data-split-mask
      data-reveal
      class="text-5xl font-semibold tracking-tight drop-shadow-lg sm:text-7xl lg:text-8xl"
    >
      {site.name}
    </h1>

    <p data-hero-fade data-reveal class="mt-6 max-w-xl text-lg text-balance text-sand sm:text-xl">
      {site.tagline}
    </p>

    <div data-hero-fade data-reveal class="mt-10">
      <a
        href="#paisajes"
        class="inline-block rounded-full bg-gold px-6 py-3 font-medium text-desert-night transition-[background-color,scale] duration-150 ease-out hover:bg-sand motion-safe:active:scale-97"
      >
        Explorar
      </a>
    </div>

    <p
      data-hero-fade
      data-reveal
      class="absolute bottom-8 text-xs tracking-[0.3em] text-sand/70 uppercase"
    >
      Desliza
    </p>
  </div>

  <!-- Después del contenido para quedar encima: el contenedor del texto cubre toda la foto -->
  <PhotoCredit {...credit} class="sm:px-8" />
</section>

<script>
  import { animate, gsap, MOTION, SplitText } from '@/lib/gsap'

  const hero = document.querySelector<HTMLElement>('[data-hero]')
  const title = hero?.querySelector<HTMLElement>('[data-hero-title]')

  if (hero && title) {
    animate(hero, ({ reduceMotion, afterFonts }) => {
      if (reduceMotion) return

      // Cortina: el hero queda fijo sin agregar espacio de scroll (pinSpacing: false)
      // y la sección siguiente sube por encima hasta taparlo. Mientras tanto la foto
      // se acerca un poco y el texto se desvanece.
      gsap
        .timeline({
          scrollTrigger: {
            trigger: hero,
            start: 'top top',
            end: 'bottom top',
            pin: true,
            pinSpacing: false,
            scrub: true,
            refreshPriority: 1,
          },
        })
        .to('[data-hero-media]', { scale: 1.1, ease: 'none', duration: 1 }, 0)
        .to(
          '[data-hero-content]',
          { yPercent: -30, autoAlpha: 0, ease: 'power1.in', duration: 0.6 },
          0,
        )

      // La foto es lo primero que se ve (LCP): queda visible desde el inicio y
      // solo se asienta con un zoom suave, sin esperar a la fuente
      gsap.fromTo(
        hero.querySelector('[data-hero-image]'),
        { scale: MOTION.zoom },
        { scale: 1, duration: MOTION.settle, ease: MOTION.ease },
      )

      // Entrada del texto: SplitText debe medir con la fuente final cargada.
      // El título es el protagonista; subtítulo y botón acompañan con `text`.
      afterFonts(() => {
        const split = SplitText.create(title, { type: 'words', mask: 'words' })
        gsap
          .timeline({ defaults: { ease: MOTION.ease } })
          .set(title, { autoAlpha: 1 }, 0)
          .fromTo(
            split.words,
            { yPercent: MOTION.maskFrom },
            { yPercent: 0, stagger: MOTION.staggerBlock, duration: MOTION.hero },
            0,
          )
          .fromTo(
            hero.querySelectorAll('[data-hero-fade]'),
            { autoAlpha: 0, y: MOTION.rise },
            { autoAlpha: 1, y: 0, stagger: MOTION.staggerBlock, duration: MOTION.text },
            0.4,
          )
      })
    })
  }
</script>
